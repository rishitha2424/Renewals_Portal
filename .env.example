# Mobileum Renewals Intelligence — Environment Variables Template
# Copy this file to .env and adjust values for your environment.
# Never commit .env with real secrets.

# --- Database ---
# For local SQLite development:
DATABASE_URL=sqlite:///renewals.db
# For production PostgreSQL container / host:
# DATABASE_URL=postgresql+psycopg://renewals_user:change_me_in_production@db:5432/renewals_prod

# PostgreSQL container settings (used by docker-compose)
POSTGRES_DB=renewals_prod
POSTGRES_USER=renewals_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# --- Application Secrets ---
SECRET_KEY=change_this_to_a_long_random_secret_in_production

# --- CORS Origins ---
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:5173","http://localhost:3000"]

# --- AI Provider ---
# Set AI_PROVIDER to one of: demo | gemini | openai | custom
# "demo" requires no API key and answers from local analytics data.
AI_PROVIDER=demo
AI_BASE_URL=
AI_MODEL_NAME=
AI_API_KEY=

# --- Uploads & Storage ---
UPLOAD_DIR=/app/uploads

# --- Admin Authentication & Write Route Security (Addendum D) ---
# Mandatory in production. Writes and uploads are disabled if unset.
ADMIN_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=
# Set to "production" in production environments (enforces secure cookies by default)
ENVIRONMENT=development
# Set to true when serving over HTTPS; false for local HTTP dev
COOKIE_SECURE=
