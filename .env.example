# Database Configuration
# PostgreSQL connection URI (use postgresql+psycopg:// or standard postgresql:// in production)
DATABASE_URL=postgresql://renewals_user:change_this_db_password_in_prod@localhost:5432/renewals_prod

# Server Network & Runtime Configuration
# Port on which the application server listens (defaults to 8000 if unset)
PORT=8000
# Deployment environment ("production" or "development")
# Defaults to "development" if unset. In production, session cookies default to secure=true.
ENVIRONMENT=production
# Enforce HTTPS-only Secure attribute on HttpOnly session cookies.
# Set to false for local development over HTTP (e.g. http://localhost:5173 or http://localhost:8000),
# which prevents browsers from dropping cookies over plain HTTP connections.
# Set to true in production deployments served over HTTPS.
# When unset, automatically defaults to true if ENVIRONMENT=production, false otherwise.
COOKIE_SECURE=true
# Allowed cross-origin resource sharing origins (JSON array or comma-separated list)
CORS_ORIGINS=["https://renewals.example.com"]
# Application title displayed in the browser tab and topbar header
APP_TITLE=Mobileum Horizon
# Semantic application release version reported by /api/health
APP_VERSION=1.0.0
# Flag indicating test runner mode; disables infinite background workers and tasks
TESTING=false

# Admin Authentication & Security
# Master password required for administrative actions, column management, and change log access
ADMIN_PASSWORD=change_this_admin_password_to_a_secure_passphrase_in_prod
# 32+ byte high-entropy secret key used for signing administrative session HMAC tokens
ADMIN_SECRET_KEY=replace_with_a_random_32_byte_hex_secret_key_for_signing_tokens
# System Owner account credentials
# OWNER_EMAIL: Email address of the primary system administrator / owner.
# If unset, the application retains the existing owner account in the database without inventing one.
OWNER_EMAIL=owner@example.com
# OWNER_NAME: Display name of the system owner. Defaults to "Administrator" if unset and creating fresh.
OWNER_NAME=Administrator
# Session lifetime in hours before administrative tokens expire
ADMIN_TOKEN_EXPIRE_HOURS=8

# Storage & File Paths
# Filesystem directory path for storing uploads and workbook data
DATA_DIR=data
# Filesystem directory path for application static brand assets and logos
ASSETS_DIR=assets
# Path to company logo image file used in PDF and PowerPoint executive reports
REPORT_LOGO_PATH=assets/logo.png
# Custom directory path where automated daily custom column and annotation backups are saved
ANNOTATION_BACKUP_PATH=data/backups/annotations
# Number of daily JSON annotation backup snapshots retained before pruning
ANNOTATION_BACKUP_RETENTION=14

# Renewal Business Rules & Logic
# Calendar month integer representing fiscal year commencement (1 = January)
FISCAL_YEAR_START_MONTH=1
# Include deals expiring in prior fiscal years within delayed renewal calculations
DELAYED_INCLUDE_PRIOR_FY=true
# ACV dollar threshold above which a renewal requires executive approval
APPROVAL_DEAL_SIZE_THRESHOLD=100000.0
# Lookahead window in days for identifying upcoming high-risk renewals
NEEDS_ATTENTION_WINDOW_DAYS=14
# Maximum number of prioritized deals displayed in the needs attention drawer
NEEDS_ATTENTION_MAX_ITEMS=5

# AI Copilot & LLM Configuration
# Selected AI copilot provider ("demo", "gemini", "openai", or "custom")
AI_PROVIDER=demo
# Enables mock AI summaries without calling external LLM APIs (recommended for demo/offline use)
DEMO_MODE=true
# Base API URL for generative AI copilot provider (optional)
AI_BASE_URL=https://generativelanguage.googleapis.com
# Model identifier for generative AI responses (e.g. gemini-1.5-flash)
AI_MODEL_NAME=gemini-1.5-flash
# Secret API key for authenticating with the generative AI provider
AI_API_KEY=fake_ai_api_key_placeholder
# Base endpoint URL for OpenAI-compatible LLM service
LLM_BASE_URL=https://api.openai.com/v1
# Secret API key for OpenAI-compatible LLM service
LLM_API_KEY=fake_llm_api_key_placeholder
# Model name for OpenAI-compatible endpoint
LLM_MODEL=gpt-4o-mini
# Maximum timeout in seconds when awaiting LLM completion responses
LLM_TIMEOUT=30
# Maximum tool call iterations permitted in a single agent reasoning loop
LLM_MAX_TOOL_CALLS=6
# Data granularity sent to the LLM ("aggregates" or "full")
LLM_SEND_MODE=aggregates

# Email & SMTP Configuration (Round 18)
# Enable background email dispatch (defaults to false; outbox queues items if false/unset)
MAIL_ENABLED=false
# Outgoing SMTP mail server hostname (e.g. smtp.office365.com, smtp.gmail.com)
SMTP_HOST=smtp.office365.com
# Outgoing SMTP port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587
# Seconds to wait for the SMTP server. Slow relays can take over 20 seconds to greet.
SMTP_TIMEOUT=60
SMTP_TIMEOUT_SECONDS=60
# Password hashing computation cost (bcrypt rounds, default 12; produces 100-300ms verification)
BCRYPT_ROUNDS=12
# SMTP username / sender account
SMTP_USER=renewals@mobileum.com
# SMTP account password or application-specific password
SMTP_PASSWORD=change_this_smtp_password_in_prod
# Enable opportunistic STARTTLS (recommended for port 587)
SMTP_STARTTLS=true
# Enable direct SSL/TLS encryption (recommended for port 465)
SMTP_SSL=false
# Email address appearing in the From header
MAIL_FROM=renewals@mobileum.com
# Base application URL used when rendering clickable invite, reset, and message thread links in emails
APP_BASE_URL=http://localhost:5173
# Primary administrator alert email recipient for owner sync alerts and system notices
ADMIN_ALERT_EMAIL=alerts@example.com

# Microsoft SSO (Entra ID / Azure AD OIDC)
# Set to true to enable single sign-on with corporate Microsoft work accounts
SSO_ENABLED=false
# Azure AD Directory (tenant) ID GUID from Azure portal App Registration
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Azure AD Application (client) ID GUID from Azure portal App Registration
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Azure AD Client Secret VALUE (not Secret ID) generated under Certificates & secrets
AZURE_CLIENT_SECRET=change_this_to_azure_client_secret_value
# Optional OAuth redirect URI. Defaults to APP_BASE_URL + /api/auth/sso/callback
SSO_REDIRECT_URI=http://localhost:5173/api/auth/sso/callback
# Optional comma-separated list of corporate email domains permitted to authenticate via SSO
SSO_ALLOWED_DOMAINS=mobileum.com,roamware.com
# Ordered list of token claims to check for user email address (tries email, preferred_username, upn)
SSO_EMAIL_CLAIM=email,preferred_username,upn
# Keep password login enabled for system owner as break-glass emergency access
SSO_LOCAL_LOGIN_ENABLED=true
# When true, non-owner users may also use password login in addition to Microsoft SSO
SSO_PASSWORD_LOGIN_FOR_USERS=false
# Optional expiration date of AZURE_CLIENT_SECRET (YYYY-MM-DD) for admin alert banners
SSO_CLIENT_SECRET_EXPIRES=2027-12-31

# Integration Testing (Optional)
# Temporary PostgreSQL database URI used when executing automated Postgres migration tests
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/renewals_test
