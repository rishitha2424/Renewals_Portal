# Database Configuration
# PostgreSQL connection URI (use postgresql+psycopg:// or standard postgresql:// in production)
DATABASE_URL=postgresql://renewals_user:change_this_db_password_in_prod@localhost:5432/renewals_prod

# Server Network & Runtime Configuration
# Port on which the application server listens (defaults to 8000 if unset)
PORT=8000
# Deployment environment ("production" or "development")
ENVIRONMENT=production
# Enforce HTTPS-only secure attribute on session cookies (defaults to true when ENVIRONMENT=production)
COOKIE_SECURE=true
# Allowed cross-origin resource sharing origins (JSON array or comma-separated list)
CORS_ORIGINS=["https://renewals.example.com"]
# Application title displayed in the browser tab and topbar header
APP_TITLE=Mobileum Horizon
# Semantic application release version reported by /api/health
APP_VERSION=1.0.0
# Flag indicating test runner mode; disables infinite background workers and tasks
TESTING=false

# Admin Authentication & Security
# Master password required for administrative actions, column management, and change log access
ADMIN_PASSWORD=change_this_admin_password_to_a_secure_passphrase_in_prod
# 32+ byte high-entropy secret key used for signing administrative session HMAC tokens
ADMIN_SECRET_KEY=replace_with_a_random_32_byte_hex_secret_key_for_signing_tokens
# Session lifetime in hours before administrative tokens expire
ADMIN_TOKEN_EXPIRE_HOURS=8

# Storage & File Paths
# Filesystem directory path for storing uploads and workbook data
DATA_DIR=data
# Filesystem directory path for application static brand assets and logos
ASSETS_DIR=assets
# Custom directory path where automated daily custom column and annotation backups are saved
ANNOTATION_BACKUP_PATH=data/backups/annotations
# Number of daily JSON annotation backup snapshots retained before pruning
ANNOTATION_BACKUP_RETENTION=14

# Renewal Business Rules & Logic
# Calendar month integer representing fiscal year commencement (1 = January)
FISCAL_YEAR_START_MONTH=1
# Include deals expiring in prior fiscal years within delayed renewal calculations
DELAYED_INCLUDE_PRIOR_FY=true
# ACV dollar threshold above which a renewal requires executive approval
APPROVAL_DEAL_SIZE_THRESHOLD=100000.0
# Lookahead window in days for identifying upcoming high-risk renewals
NEEDS_ATTENTION_WINDOW_DAYS=14
# Maximum number of prioritized deals displayed in the needs attention drawer
NEEDS_ATTENTION_MAX_ITEMS=5

# AI Copilot & LLM Configuration
# Selected AI copilot provider ("demo", "gemini", "openai", or "custom")
AI_PROVIDER=demo
# Enables mock AI summaries without calling external LLM APIs (recommended for demo/offline use)
DEMO_MODE=true
# Base API URL for generative AI copilot provider (optional)
AI_BASE_URL=https://generativelanguage.googleapis.com
# Model identifier for generative AI responses (e.g. gemini-1.5-flash)
AI_MODEL_NAME=gemini-1.5-flash
# Secret API key for authenticating with the generative AI provider
AI_API_KEY=fake_ai_api_key_placeholder
# Base endpoint URL for OpenAI-compatible LLM service
LLM_BASE_URL=https://api.openai.com/v1
# Secret API key for OpenAI-compatible LLM service
LLM_API_KEY=fake_llm_api_key_placeholder
# Model name for OpenAI-compatible endpoint
LLM_MODEL=gpt-4o-mini
# Maximum timeout in seconds when awaiting LLM completion responses
LLM_TIMEOUT=30
# Maximum tool call iterations permitted in a single agent reasoning loop
LLM_MAX_TOOL_CALLS=6
# Data granularity sent to the LLM ("aggregates" or "full")
LLM_SEND_MODE=aggregates

# Integration Testing (Optional)
# Temporary PostgreSQL database URI used when executing automated Postgres migration tests
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/renewals_test
