# Set default behavior to automatically normalize line endings
* text=auto

# Enforce Unix LF line endings for scripts, services, and configs
*.sh text eol=lf
*.bash text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.env* text eol=lf
Dockerfile* text eol=lf
docker-compose*.yml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
