[Unit]
Description=Mobileum Horizon Renewals Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=renewals
Group=renewals
WorkingDirectory=/opt/renewals
# Use 1 worker to preserve in-memory snapshot state, avoid database locking contention, and fit container memory bounds
ExecStart=/opt/renewals/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
